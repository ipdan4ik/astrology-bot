DATABASE_URL=postgresql+asyncpg://quantuum:quantuum@postgres:5432/quantuum
REDIS_URL=redis://redis:6379/0
JWT_SIGNING_KEY=change-me-in-prod
BOT_TOKEN=
WEBHOOK_SECRET_PATH=
BOT_TOKEN_ENC_KEY=wWyNAOxSSib9kfo4PeMJ6CX-ugqbCPhAp6kLVqHQL_0=
DEFAULT_BOT_TRANSPORT=polling
API_HOST=http://localhost:8000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@quantuum.example
LOG_JSON=true
# Master / onboarding bot (separate from the product bot)
MASTER_BOT_TOKEN=
MASTER_BOT_USERNAME=
# First superadmin (created on api startup if the email has no identity yet)
BOOTSTRAP_SUPERADMIN_EMAIL=
# LLM blueprint polish (the task-worker calls this). Without LLM_API_KEY the
# worker gracefully delivers the raw calculated calc_md (llm_provider="none").
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6
LLM_TEMPERATURE=0.85
LLM_MAX_TOKENS=9000
